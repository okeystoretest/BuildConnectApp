# ─── Banco ────────────────────────────────────────────────────────────────
# Postgres do Easy Panel. Entre serviços do mesmo projeto use o NOME DO
# SERVIÇO como host (rede interna do Docker), não localhost nem o IP público.
DATABASE_URL="postgres://buildconnect:SENHA_FORTE@meu-postgres:5432/buildconnect?schema=public"

# ─── Sessão ───────────────────────────────────────────────────────────────
# Mínimo 16 caracteres. Gere com: openssl rand -base64 48
# Trocar este valor derruba todas as sessões ativas.
SESSION_SECRET="troque-por-um-valor-aleatorio-longo"

# ─── Uploads ──────────────────────────────────────────────────────────────
# Precisa apontar para o volume persistente montado no container.
UPLOADS_DIR="/var/www/app/uploads"

# ─── Seed (só na primeira carga da base) ──────────────────────────────────
# Senha inicial dos usuários criados pelo seed, admin incluído. Em produção o
# seed RECUSA rodar sem esta variável. Use uma vez, no console, e troque a
# senha do admin pela interface depois:
#   SEED_PASSWORD="..." npx prisma db seed
SEED_PASSWORD=""

# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT="3000"

# ─── Cron de avaliações (opcional) ────────────────────────────────────────
# Sem esta variável a rota /api/cron/evaluations fica desabilitada.
CRON_SECRET=""

# ─── Geocodificação de chamados (opcional) ────────────────────────────────
GEOCODE_USER_AGENT="build-connect/1.0 (contato@suaempresa.com.br)"
GEOCODE_DEFAULT_CITY=""
GEOCODE_DEFAULT_STATE=""
